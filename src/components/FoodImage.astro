---
interface Props {
  name: string;
  image?: string;
  class?: string;
  /** aspect ratio utility, e.g. 'aspect-[4/3]' */
  aspect?: string;
  loading?: 'lazy' | 'eager';
}

const { name, image, class: className = '', aspect = 'aspect-[4/3]', loading = 'lazy' } = Astro.props;
---

{
  image ? (
    <img
      src={image}
      alt={name}
      loading={loading}
      class:list={['h-full w-full object-cover', aspect, className]}
    />
  ) : (
    <div
      class:list={[
        'relative flex h-full w-full items-center justify-center overflow-hidden',
        'bg-[radial-gradient(120%_120%_at_30%_20%,oklch(0.28_0.02_55)_0%,oklch(0.19_0.015_55)_55%,oklch(0.14_0.012_55)_100%)]',
        aspect,
        className,
      ]}
      role="img"
      aria-label={`${name} - photo coming soon`}
    >
      <div class="flex flex-col items-center gap-2 px-4 text-center">
        <svg
          class="text-ember/80 h-7 w-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
        </svg>
        <span class="font-heading text-[0.65rem] font-semibold tracking-[0.22em] text-white/50 uppercase">
          {name}
        </span>
      </div>
      <div class="absolute inset-0 bg-[linear-gradient(115deg,transparent_40%,rgb(255_255_255/0.03)_50%,transparent_60%)]" />
    </div>
  )
}
