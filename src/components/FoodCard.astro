---
import type { MenuItem } from '@/consts/menu';
import FoodImage from '@/components/FoodImage.astro';

interface Props {
  item: MenuItem;
  delay?: number;
}
const { item, delay = 0 } = Astro.props;
---

<article
  class="food-card group bg-card border-border/60 border shadow-sm hover:shadow-xl"
  data-reveal
  style={`--reveal-delay:${delay}ms`}
>
  <div class="food-card-media relative">
    <FoodImage name={item.name} image={item.image} />
    {
      item.badges?.[0] && (
        <span class="bg-ember absolute top-3 left-3 rounded-full px-3 py-1 text-[0.65rem] font-bold tracking-[0.14em] text-white uppercase">
          {item.badges[0]}
        </span>
      )
    }
  </div>
  <div class="p-3.5 sm:p-5">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-heading text-base font-bold tracking-tight sm:text-lg">{item.name}</h3>
      {
        item.price && (
          <span class="text-ember font-heading text-base font-bold tabular-nums">{item.price}</span>
        )
      }
    </div>
    <p class="text-muted-foreground mt-2 line-clamp-2 text-xs leading-relaxed sm:text-sm">{item.description}</p>
  </div>
</article>
