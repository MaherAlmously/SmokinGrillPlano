---
interface Props {
  class?: string;
  /** 'light' for dark backgrounds, 'dark' for light backgrounds */
  tone?: 'light' | 'dark';
  size?: number;
}
const { class: className = '', tone = 'light', size = 120 } = Astro.props;
const ring = tone === 'light' ? 'text-white/80' : 'text-char/80';
---

<div
  class:list={['relative inline-flex items-center justify-center', ring, className]}
  style={`width:${size}px;height:${size}px`}
  title="100% Zabiha Halal · Hand-Slaughtered"
>
  <svg viewBox="0 0 120 120" class="absolute inset-0 h-full w-full" aria-hidden="true">
    <defs>
      <path id="halal-circle" d="M 60,60 m -46,0 a 46,46 0 1,1 92,0 a 46,46 0 1,1 -92,0" />
    </defs>
    <circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5" />
    <circle cx="60" cy="60" r="34" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" />
    <text
      class="font-heading"
      font-size="10.5"
      font-weight="700"
      letter-spacing="2.6"
      fill="currentColor"
    >
      <textPath href="#halal-circle" startOffset="0%">
        100% ZABIHA HALAL · HAND-SLAUGHTERED ·
      </textPath>
    </text>
  </svg>
  <svg
    class="text-ember h-8 w-8"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
  </svg>
  <span class="sr-only">100% Zabiha Halal - hand-slaughtered meat only</span>
</div>
