---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  class?: string;
}
const {
  eyebrow,
  title,
  description,
  align = 'center',
  tone = 'dark',
  class: className = '',
} = Astro.props;
const alignCls = align === 'center' ? 'text-center mx-auto' : 'text-left';
const titleCls = tone === 'light' ? 'text-white' : 'text-foreground';
const descCls = tone === 'light' ? 'text-white/60' : 'text-muted-foreground';
---

<div class:list={['max-w-2xl', alignCls, className]} data-reveal>
  {
    eyebrow && (
      <p class:list={['eyebrow mb-4 flex items-center gap-3', align === 'center' && 'justify-center']}>
        <span class="ember-rule" aria-hidden="true" />
        {eyebrow}
        <span class="ember-rule" aria-hidden="true" />
      </p>
    )
  }
  <h2 class:list={['display text-3xl sm:text-4xl lg:text-5xl', titleCls]}>{title}</h2>
  {description && <p class:list={['mt-5 text-base leading-relaxed sm:text-lg', descCls]}>{description}</p>}
</div>
